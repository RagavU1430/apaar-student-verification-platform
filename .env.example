# ==============================================================================
# AICTE APAAR Platform - Environment Variables (.env.example)
# ==============================================================================

# ---- Supabase Client (Frontend) ---------------------------------------------
# Found in: Supabase Dashboard -> Project Settings -> API
# Note: Publishable / anon key is safe for client-side use with RLS enabled.
# NEVER expose the service_role secret here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-placeholder

# ---- Database (Managed PostgreSQL / Supabase CLI) ---------------------------
# Direct connection string for migrations and Supabase CLI
# Found in: Supabase Dashboard -> Project Settings -> Database -> Connection URI
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# ---- Demo Policy & Ingestion Limits -----------------------------------------
VITE_DEMO_RULE_VERSION=demo-v1
VITE_MAX_UPLOAD_BYTES=5242880
VITE_MAX_BATCH_ROWS=5000
