# ---- Runtime -------------------------------------------------------------
# Bind address for the HTTP server.
BIND_ADDR=127.0.0.1:8080

# ---- Database ------------------------------------------------------------
# Managed PostgreSQL (Supabase) connection string.
# Supabase: Project Settings -> Database -> Connection string -> URI (session mode).
# The password must be URL-encoded. Example:
#   postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
# For local development instead, run: docker compose up -d db
#   postgresql://apaar:apaar_dev_password@localhost:5432/apaar
DATABASE_URL=postgresql://apaar:apaar_dev_password@localhost:5432/apaar

# ---- Auth (prototype) ----------------------------------------------------
# Development-only secret. MUST be replaced in any shared deployment.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-change-me-0123456789abcdefghijklmnopqrstuvwxyz
JWT_TTL_MINUTES=60

# ---- Limits --------------------------------------------------------------
# Maximum accepted upload size in bytes (5 MB).
MAX_UPLOAD_BYTES=5242880
# Maximum rows accepted in a single batch.
MAX_BATCH_ROWS=5000
# Default and maximum page sizes for list endpoints.
DEFAULT_PAGE_SIZE=50
MAX_PAGE_SIZE=200

# ---- Demo policy ---------------------------------------------------------
# Label of the counting rule in use. Surfaced in the API and UI so the demo
# never claims an official AICTE rule.
DEMO_RULE_VERSION=demo-v1
# Demo-only APAAR id shape check (Level 2). This is NOT identity verification.
APAAR_DEMO_PATTERN=^[A-Z0-9-]{8,20}$

# ---- Observability -------------------------------------------------------
RUST_LOG=info,sqlx=warn,tower_http=info
